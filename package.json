{
  "name": "pulsetools",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse Studio 私人 Discord 管理系統",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/bot/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/database.integration.test.ts",
    "test:database": "vitest run tests/database.integration.test.ts",
    "test:database:sandbox": "tsx scripts/test-database.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/apps/bot/src/main.js",
    "doctor": "tsx scripts/doctor.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "commands:register": "tsx scripts/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
