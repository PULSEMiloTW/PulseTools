# 複製至 .env 後在本機填入；不得提交或貼到聊天。
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OWNER_ID=
# 只在明確指定的測試 Guild 註冊指令，逗號分隔；不會自動授權 Guild。
DISCORD_COMMAND_GUILD_IDS=
# Phase 2 手動開放 Gateway 訊息事件；先在 Developer Portal 開啟 Message Content Intent。
DISCORD_MESSAGE_EVENTS_ENABLED=false
DATABASE_URL=
# Supabase Dashboard > Database Settings > SSL Configuration 下載的 CA 憑證路徑。
DATABASE_SSL_CA_PATH=
# 整合測試必須使用專用空資料庫，禁止使用正式資料庫。
TEST_DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3200
SESSION_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3200/auth/discord/callback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
NODE_ENV=development
TZ=Asia/Taipei
LOG_LEVEL=info
