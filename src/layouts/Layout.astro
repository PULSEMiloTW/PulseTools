---
import '../styles/global.css';
import SiteControls from '../components/SiteControls';
import {tools} from '../lib/tools';
const {title,description,slug}=Astro.props;
const canonical=new URL(Astro.url.pathname.replace(/\/$/,'')||'/','https://tools.pulse-studio.live');
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | PulseTools</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#5865f2"/><script is:inline>try{const t=JSON.parse(localStorage.getItem('pulsetools:theme')||'"system"');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{try{const t=JSON.parse(localStorage.getItem('pulsetools:theme')||'"system"');if(t==='system')document.documentElement.dataset.theme=e.matches?'dark':'light';}catch{}});</script></head><body><a class="skip-link" href="#main">跳至主要內容</a><header class="site-header"><div class="header-inner"><a class="brand" href="/">Pulse<span>Tools</span></a><nav aria-label="主要導覽"><a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>全部工具</a><a href="/about">關於</a></nav><SiteControls client:load slug={slug}/></div></header><main id="main" class="page-shell">{slug&&<><div class="tool-nav"><a href="/">← 返回全部工具</a><details><summary>切換工具</summary><nav aria-label="工具切換">{tools.map(t=><a href={'/'+t.slug} aria-current={slug===t.slug?'page':undefined}>{t.name}</a>)}</nav></details></div><div class="page-heading"><h1>{title}</h1><p>{description}</p></div></>}<slot/>{slug&&<section class="related"><h2>接著使用</h2><div class="recent">{tools.filter(t=>t.slug!==slug&&t.category===tools.find(t=>t.slug===slug)?.category).slice(0,3).map(t=><a href={'/'+t.slug}>{t.name} →</a>)}<a href="/">查看全部工具 →</a></div></section>}</main><footer class="site-footer"><div><a class="brand" href="/">Pulse<span>Tools</span></a><p>日常工具，隨手可用。<br/><small>Powered by Pulse Studio</small></p></div><nav aria-label="頁尾"><a href="/about">關於本站</a><a href="/privacy">隱私說明</a></nav></footer></body></html>
